# ====================================================================
# Apache Configuration - RTQ Utsmaniyyah Munaqosyah System
# ====================================================================

# Prioritaskan index.php sebagai file default
DirectoryIndex index.php index.html

# Cegah penjelajahan direktori (Directory Browsing) demi keamanan
Options -Indexes

# Matikan caching browser agar perubahan data langsung terlihat
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</IfModule>
